<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>survivor_tagging_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 wrapper of the survivor tagging library. Substep 4.1a: ROS-free runtime and adapters plus a thin rclpy node.</description>
  <maintainer email="jainilagarwal20@gmail.com">survivor tagging maintainer</maintainer>
  <license>TODO: licence not decided</license>

  <depend>rclpy</depend>
  <depend>survivor_tagging_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
